# Required for Graphiti's default LLM, embedding, and reranking clients.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION_ID=

# Keep this identical for the Python scripts and MCP server.
GRAPHITI_GROUP_ID=agent_graph_memory
FALKORDB_DATABASE=agent_graph_memory
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# MCP model settings. The Python package uses graphiti-core's current defaults.
MODEL_NAME=gpt-5.6-luna
EMBEDDER_MODEL=text-embedding-3-small
LLM_STRUCTURED_OUTPUT_MODE=json_schema
SEMAPHORE_LIMIT=5
USER_ID=opencode
GRAPHITI_TELEMETRY_ENABLED=false
