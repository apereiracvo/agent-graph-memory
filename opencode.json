{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "default_agent": "orchestrator",
  "mcp": {
    "graphiti-memory": {
      "type": "remote",
      "url": "http://localhost:8100/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.80",
        "--isolated",
        "--timeout-action",
        "10000",
        "--timeout-navigation",
        "60000",
        "--output-dir",
        "./.mcp/playwright-outputs/"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "plugin": [
    "@iam-brain/opencode-codex-auth@1.10.0",
    "op-anthropic-auth@0.1.4"
  ],
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.local": "deny",
      ".envrc": "deny",
      ".graphiti/**": "deny",
      ".mcp/**": "deny",
      "cognee_bench/.state/**": "deny",
      ".env.example": "allow"
    }
  }
}
